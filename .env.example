# Copy to .env (gitignored) and fill in. `npm run build` / `zip` bake these into the bundle,
# so .env must hold the live URLs when you build a release. Public values only, never secrets.

# Feed API base, must end with /. Its origin also becomes the manifest host_permission.
WXT_API_BASE_URL=https://api.qx.plus/v1/feed/
# Customer portal (billing, subscription links).
WXT_PORTAL_URL=https://my.qx.plus

# Local backend (for testing only, switch back before a release build):
# WXT_API_BASE_URL=http://localhost:8000/v1/feed/
# WXT_PORTAL_URL=http://localhost:3000
